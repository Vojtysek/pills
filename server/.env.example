# Generate once with `npm run vapid-keys` (or `npx web-push generate-vapid-keys`) and keep them:
# changing the keys invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (Apple, Google, Mozilla) in case of problems.
VAPID_SUBJECT=mailto:you@example.cz

# Address(es) of the web app, comma-separated.
ALLOWED_ORIGINS=https://lekarnicka.nullbit.cz

# Admin dashboard (/admin in the app). At least 32 characters; leave empty to disable the admin API.
# Generate: openssl rand -base64 36 | tr '+/' '-_' | tr -d '='
ADMIN_TOKEN=
